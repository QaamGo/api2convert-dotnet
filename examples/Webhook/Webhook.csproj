<Project Sdk="Microsoft.NET.Sdk">

  <!-- A standalone example. Not part of Api2Convert.sln, so the guardrail build ignores it.
       Run it with the dotnet run command shown in Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AssemblyName>webhook-example</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Api2Convert/Api2Convert.csproj" />
  </ItemGroup>

</Project>
